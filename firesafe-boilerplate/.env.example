# Chép thành .env rồi đổi giá trị:   cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore).

# Khóa ký JWT, dùng chung 5 service, ít nhất 32 ký tự. Tạo khóa ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-it-nhat-32-ky-tu

# Mật khẩu PostgreSQL của 5 CSDL (chỉ có tác dụng khi tạo volume lần đầu;
# đổi mật khẩu sau đó thì chạy: docker compose down -v)
DB_PASSWORD=doi-mat-khau-csdl

# Cổng của gateway trên máy (mặc định 8088)
GATEWAY_PORT=8088

# Tên miền frontend được gọi API; * = mọi nơi, chỉ dùng khi dev
CORS_ORIGIN=*

# Tài khoản admin đầu tiên (npm run seed:admin trong service auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
